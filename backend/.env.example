# ---------------------------------------------------------------------------
# NVIDIA NIM / Nemotron
# ---------------------------------------------------------------------------
# Crea tu clave gratis en https://build.nvidia.com/settings
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Rutas de los servicios de voz. Ajústalas si tu cuenta usa otro host.
NVIDIA_ASR_PATH=/audio/transcriptions
NVIDIA_TTS_PATH=/audio/speech

# ---------------------------------------------------------------------------
# Modelos
# ---------------------------------------------------------------------------
MODEL_TEXT_DEFAULT=deepseek-ai/deepseek-v4.1-flash
MODEL_TEXT_PREMIUM=nvidia/nemotron-3-ultra-550b-a55b
MODEL_TEXT_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_OMNI=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
MODEL_OCR=nvidia/nemotron-ocr-v2
MODEL_ASR=nvidia/parakeet-ctc-0.6b-es
MODEL_TTS=nvidia/chatterbox-multilingual-tts
MODEL_EMBED=nvidia/nemotron-3-embed-1b
MODEL_SAFETY=nvidia/llama-guard-4-12b

# ---------------------------------------------------------------------------
# Límites de subida
# ---------------------------------------------------------------------------
MAX_IMAGE_MB=20
MAX_VIDEO_MB=100
MAX_VIDEO_SECONDS=120
MAX_AUDIO_MB=50
MAX_AUDIO_SECONDS=3600
MAX_DOC_MB=50
MAX_DOC_PAGES=40

# ---------------------------------------------------------------------------
# Comportamiento
# ---------------------------------------------------------------------------
UI_LANGUAGE=es
ENABLE_SAFETY=true
# Si el modelo de moderación falla, ¿dejamos pasar el mensaje?
# true = el chat sigue funcionando (útil en desarrollo, sin garantía de moderation)
SAFETY_FAIL_OPEN=true
ENABLE_TTS=true
ENABLE_RAG=true
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
FILE_TTL_HOURS=24

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
DATA_DIR=.data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,https://dzzsee.github.io
